	@Transactional
	@PostMapping("/insert/company")
	ComInResDTO InsertCompany(@RequestBody ComInInDTO In, HttpSession session) {
		if (session.getAttribute("kakaoId") == null) {
			return new ComInResDTO("NLI");
		}
		if (!"adm".equals(session.getAttribute("mode"))) {
			return new ComInResDTO("NAI");
		}
		CompanyInfo companyInfo = null;

		companyInfo = new CompanyInfo(In.getName(), In.getCompanyNumber());
		if (companyInfo == null) {
			return new ComInResDTO("NCI");
		}
		try {
			companyInfo = postService.save(companyInfo);
		} catch (Exception e) {
			return new ComInResDTO("NSI");
		}
		return new ComInResDTO("ok", companyInfo.getId(), companyInfo.getCompanyName(), companyInfo.getCompanyNumber(),
				companyInfo.getCreateAT());
	}

	@Transactional
	@PostMapping(value = "/insert/product", consumes = MediaType.MULTIPART_FORM_DATA_VALUE)
	ProInResDTO InsertProduct(@RequestPart("data") ProInInDTO In, @RequestPart("file") MultipartFile file,
			HttpSession session) throws IOException {
		if (session.getAttribute("kakaoId") == null) {
			return new ProInResDTO("NLI");
		}
		if (!"adm".equals(session.getAttribute("mode"))) {
			return new ProInResDTO("NAI");
		}

		String imageName = env.getProperty("image.base-url");
		if (!file.isEmpty()) {
			imageName += s3Service.upload(file);
			System.out.println(imageName);
		} else {
			imageName = "";
			System.out.println(imageName);
		}

		ProductInfo productInfo = null;

		productInfo = new ProductInfo(In.getProductNumber(), In.getName(), In.getStock(), In.getPrice(), imageName);
		if (productInfo == null) {
			return new ProInResDTO("NPI");
		}
		try {
			productInfo = postService.save(productInfo);
		} catch (Exception e) {
			return new ProInResDTO("NPS");
		}

		return new ProInResDTO("ok", productInfo.getId(), productInfo.getProductNumber(), productInfo.getProductName(),
				productInfo.getStock(), productInfo.getProductPrice(), productInfo.getImage(),
				productInfo.getCreateAT());
	}

	@Transactional
	@PutMapping(value = "/motify/product", consumes = MediaType.MULTIPART_FORM_DATA_VALUE)
	ProMoResDTO UpdateProduct(@RequestPart("data") ProMoInDTO In, @RequestPart("file") MultipartFile file,
			HttpSession session) throws IOException {
		if (session.getAttribute("kakaoId") == null) {
			return new ProMoResDTO("NLI");
		}
		if (!"adm".equals(session.getAttribute("mode"))) {
			return new ProMoResDTO("NAI");
		}
		String imageName = env.getProperty("image.base-url");
		if (!file.isEmpty()) {
			imageName += s3Service.upload(file);
		} else {
			imageName = "";
		}

		ProductInfo productInfo = postService.findByProductID(In.getId());
		if (productInfo == null) {
			return new ProMoResDTO("NPI");
		}
		productInfo.setProductNumber(In.getProductNumber());
		productInfo.setImage(In.getImage());
		productInfo.setProductName(In.getName());
		productInfo.setProductPrice(In.getPrice());

		productInfo.setStock(In.getStock());
		productInfo.setCreateAT(LocalDateTime.now());

		return new ProMoResDTO("ok", productInfo.getId(), productInfo.getProductNumber(), productInfo.getProductName(),
				productInfo.getStock(), productInfo.getProductPrice(), imageName, productInfo.getCreateAT());
	}

