	@Transactional
	@DeleteMapping("/delete/product")
	ProductInfoDTO DeleteProduct(@RequestBody DeleteProductDTO In, HttpSession session) {
		if (session.getAttribute("kakaoId") == null) {
			return new ProductInfoDTO("NLI");
		}
		if (!"adm".equals(session.getAttribute("mode"))) {
			return new ProductInfoDTO("NAI");
		}

		ProductInfo productInfo = postService.findByProductID(In.getId());
		List<Product> product = new ArrayList();
		if (productInfo != null) {
			product = postService.findByProductInfos(productInfo);
		}
		List<Trade> trade = new ArrayList();
		for (int i = 0; i < product.size(); i++) {
			trade.addAll(postService.findByproducts(product.get(i)));
		}
		List<SalesList> sales = new ArrayList();
		for (int i = 0; i < trade.size(); i++) {
			sales.addAll(postService.findByTrades(trade.get(i)));
		}
		List<BuyList> buys = new ArrayList();
		for (int i = 0; i < trade.size(); i++) {
			buys.addAll(postService.findBybuyTrades(trade.get(i)));
		}

		for (int i = 0; i < buys.size(); i++) {
			postService.deleteBybuylist(buys.get(i));
		}
		for (int i = 0; i < sales.size(); i++) {
			postService.deleteBysaleslist(sales.get(i));
		}
		for (int i = 0; i < trade.size(); i++) {
			postService.deleteBytrade(trade.get(i));
		}
		for (int i = 0; i < product.size(); i++) {
			postService.deleteByProduct(product.get(i));
		}
		if (productInfo != null) {
			postService.deleteByProductInfo(productInfo);
		}
		return new ProductInfoDTO("ok");
	}

