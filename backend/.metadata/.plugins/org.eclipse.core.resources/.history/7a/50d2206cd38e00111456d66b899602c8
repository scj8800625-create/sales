					sales.get(i).getTrade().getProduct().getProductInfo().getImage()));
		}
		if (sales.size() != 0) {
			for (int i = 0; i < buys.size(); i++) {
				totalDTO.add(new TotalDTO(buys.get(i).getId(), buys.get(i).getTrade().getProduct().getCompany().getId(),
						buys.get(i).getTrade().getProduct().getProductInfo().getId(),
						buys.get(i).getTrade().getProduct().getId(), buys.get(i).getTrade().getId(),
						buys.get(i).getId() + sales.get(sales.size() - 1).getId(), buys.get(i).getBuyDate(),
						buys.get(i).getContentType(),
						buys.get(i).getTrade().getProduct().getCompany().getCompanyInfo().getCompanyName(),
						buys.get(i).getTrade().getProduct().getProductInfo().getProductName(),
						buys.get(i).getTrade().getProduct().getCompany().getUserInfo().getAuth().getNickname(),
						buys.get(i).getBuyQualtity(), buys.get(i).getBuy_price(),
						buys.get(i).getTrade().getProduct().getProductInfo().getImage()));
			}
		} else {
			for (int i = 0; i < buys.size(); i++) {
				totalDTO.add(new TotalDTO(buys.get(i).getId(), buys.get(i).getTrade().getProduct().getCompany().getId(),
						buys.get(i).getTrade().getProduct().getProductInfo().getId(),
						buys.get(i).getTrade().getProduct().getId(), buys.get(i).getTrade().getId(),
						buys.get(i).getId(), buys.get(i).getBuyDate(), buys.get(i).getContentType(),
						buys.get(i).getTrade().getProduct().getCompany().getCompanyInfo().getCompanyName(),
						buys.get(i).getTrade().getProduct().getProductInfo().getProductName(),
						buys.get(i).getTrade().getProduct().getCompany().getUserInfo().getAuth().getNickname(),
						buys.get(i).getBuyQualtity(), buys.get(i).getBuy_price(),
						buys.get(i).getTrade().getProduct().getProductInfo().getImage()));
			}
		}
		totalDTO.sort(Comparator.comparing(TotalDTO::getDate));
		return totalDTO;
	}

	@Transactional
	@PostMapping("/insert/ProductList")
	ListDto ProductList(@RequestBody InsertListDTO In, HttpSession session) {
		if (session.getAttribute("kakaoId") == null) {
			throw new RuntimeException("로그인이 필요합니다.");
		}
		if (!"adm".equals(session.getAttribute("mode"))) {
			throw new RuntimeException("운영자 id가 아닙니다.");
		}
		Long KakaoId = (Long) session.getAttribute("kakaoId");

		CompanyInfo comInfo = postService.findByCompanyName(In.getCompany());

		Auth auth = memberService.findById(KakaoId);
		if (auth == null) {
			throw new RuntimeException("회원정보가 없습니다.");
		}
		UserInfo userInfo = memberService.findByAuth(auth);
		if (userInfo == null) {
			throw new RuntimeException("회원정보가 없습니다.");
		}
		ProductInfo productInFo = postService.findByProductName(In.getProduct());
		if (productInFo == null) {
			throw new RuntimeException("제품정보가 없습니다.");
		}
		Company company = null;
		try {

			company = postService.findByUserInfoAndCompanyInfo(userInfo, comInfo);
			if (company == null) {
				company = new Company(userInfo, comInfo);
				company = postService.save(company);
			}

		} catch (Exception e) {
			e.printStackTrace(); // 또는 log.error(...)
			throw e;

		}
		Product product = null;
		try {
			product = postService.findByProductInfoAndCompanyName(productInFo, company);
			if (product == null) {
				product = new Product(productInFo, company);
				postService.save(product);
			}
		} catch (Exception e) {

			throw new RuntimeException("제품정보가 없습니다.");
		}

		Trade trade = null;
		try {
			trade = postService.findByProduct(product);
			if (trade == null) {
				trade = new Trade(product);
				trade = postService.save(trade);
				product.getTrade().add(trade);

			}

		} catch (Exception e) {
			throw new RuntimeException("거래정보가 없습니다.");
		}

		SalesList saleslist = null;
		BuyList buylist = null;
		if (In.getFlow().equals("in")) {
			buylist = new BuyList(In.getFlow(), In.getQuantity(), trade, In.getDate(), In.getPrice());
			buylist = postService.save(buylist);
			// trade.getBuylist().add(buylist);
		} else {
			saleslist = new SalesList(In.getFlow(), In.getQuantity(), trade, In.getDate(), In.getPrice());
			saleslist = postService.save(saleslist);
			// trade.getSaleslist().add(saleslist);
		}

		if (In.getFlow().equals("in")) {
			return new ListDto(buylist.getId(), buylist.getTrade().getProduct().getCompany().getCompanyInfo().getId(),
					buylist.getTrade().getProduct().getCompany().getId(),
					buylist.getTrade().getProduct().getProductInfo().getId(), buylist.getTrade().getProduct().getId(),
					buylist.getTrade().getId(), buylist.getBuyDate(), buylist.getContentType(),
					company.getCompanyInfo().getCompanyName(), productInFo.getProductName(), auth.getNickname(),
					buylist.getBuyQualtity(), buylist.getBuy_price(), productInFo.getImage());
		} else {
			return new ListDto(saleslist.getId(),
					saleslist.getTrade().getProduct().getCompany().getCompanyInfo().getId(),
					saleslist.getTrade().getProduct().getCompany().getId(),
					saleslist.getTrade().getProduct().getProductInfo().getId(),
					saleslist.getTrade().getProduct().getId(), saleslist.getTrade().getId(), saleslist.getSalesDate(),
					saleslist.getContentType(), company.getCompanyInfo().getCompanyName(), productInFo.getProductName(),
					auth.getNickname(), saleslist.getSalesQualtity(), saleslist.getSales_price(),
					productInFo.getImage());
		}

	}

