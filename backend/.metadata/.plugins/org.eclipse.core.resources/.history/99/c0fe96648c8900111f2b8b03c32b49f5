package com.example.demo.post.post.repository;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;

import com.example.demo.post.post.entity.SalesList;
import com.example.demo.post.post.entity.Trade;


@Repository
public interface SalesListRepository extends JpaRepository<SalesList, Long> {

	SalesList findAllById(Long id);

	List<SalesList> findByTrade(Trade trade);

	SalesList findByIdAndTrade(Long id, Trade trade);

}
